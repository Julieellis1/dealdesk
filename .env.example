# ---------- Server ----------
PORT=3001
# 127.0.0.1 = only this computer can open the app. Use 0.0.0.0 to open it from your phone on the same Wi-Fi
# (then also set APP_PASSWORD below).
HOST=127.0.0.1
# Where the SQLite database lives (relative to the project folder)
DATA_DIR=data

# ---------- Security ----------
# Encrypts the AI API keys you save in Settings → AI Models. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a key is generated into data/.encryption_key on first run. Back it up either way:
# if you lose it, you'll need to re-enter your API keys (contracts and invoices are unaffected).
ENCRYPTION_KEY=

# Optional: ask for a password (browser login prompt, any username) before the app opens.
# Strongly recommended if HOST is not 127.0.0.1 or the app is online. Invoice share links stay public.
APP_PASSWORD=

# Optional: the public address of this app once deployed, used to build invoice share links.
# e.g. https://deals.example.com
PUBLIC_URL=

# How long to wait for one AI model before falling back to the next (milliseconds)
AI_TIMEOUT_MS=60000

# ---------- Email (optional) ----------
# Needed only for "Send with PDF attached". Without it you can still download the PDF or use your own email app.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and an App Password
# (Google Account → Security → App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Name <you@example.com>"
